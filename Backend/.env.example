# ============================================================================
# TECLIA ACADEMIA - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env (frontend) or Backend/.env (backend) as appropriate.
# Never commit real secrets to source control.

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

PORT=3001
NODE_ENV=development

# Prisma database connection. Upstream uses PostgreSQL/Supabase.
DATABASE_URL=

# Use a dedicated test database; never run tests against production.
TEST_DATABASE_URL=

# Legacy/local database options retained for compatibility with existing tooling.
DATABASE_PATH=
DATABASE_DIR=
SQLITE_DB_PATH=
DB_TYPE=

JWT_SECRET=

# ============================================================================
# SUPABASE AND STORAGE
# ============================================================================

SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=

LOCAL_UPLOADS=
# Set to false on Vercel/serverless (use Supabase storage instead).
UPLOAD_MAX_SIZE_MB=
UPLOAD_ALLOWED_TYPES=

# Legacy upload settings retained for compatibility.
MAX_UPLOAD_SIZE=
ALLOWED_AVATAR_TYPES=
UPLOAD_DIR=

# ============================================================================
# EMAIL
# ============================================================================

SENDGRID_API_KEY=
EMAIL_FROM=
PASSWORD_RESET_TEMPLATE_ID=

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Legacy backend URL and Vite API base URL.
FRONTEND_API_URL=
VITE_API_BASE_URL=
VITE_APP_NAME=

# Stripe Elements. Use only a publishable key; never expose a secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=

# Payments remain disabled unless explicitly enabled.
VITE_PAYMENTS_ENABLED=

# ============================================================================
# SECURITY AND CORS
# ============================================================================

CORS_ORIGIN=

# Stripe (backend only — never expose in VITE_ variables)
STRIPE_SECRET_KEY=

# Configure exactly one Stripe webhook destination at POST /api/webhooks/stripe.
# POST /api/payments/webhook is a compatibility alias that uses the same verifier
# and dispatcher; do not register it as a second Stripe destination. Copy the
# canonical destination's endpoint signing secret (whsec_...) here.
STRIPE_WEBHOOK_SECRET=

# Maximum accepted Stripe signature age in seconds. Defaults to 300 when unset.
STRIPE_WEBHOOK_TOLERANCE_SEC=300

# Stripe Checkout Session price IDs (Dashboard → Products → Prices).
# Must be recurring prices — checkout now runs in mode:'subscription', and
# these same IDs are used in reverse (price -> plan_tier) by the webhook
# when handling customer.subscription.updated.
STRIPE_PRICE_BASICO=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MASTER=

# Hosted Checkout redirect URLs ({CHECKOUT_SESSION_ID} is substituted by Stripe)
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=

SESSION_TIMEOUT=

# ============================================================================
# DEVELOPMENT AND DEBUGGING
# ============================================================================

DEBUG=
VERBOSE_ERRORS=

# ============================================================================
# DEPLOYMENT AND OPTIONAL SERVICES
# ============================================================================

# Required for byte-exact Stripe webhook bodies on Vercel. Configure this value
# for Production, Preview, and Development in the Vercel project settings.
# A Vercel production deployment fails during app startup unless it is exactly 0.
NODEJS_HELPERS=0

GITHUB_TOKEN=
DEPLOYMENT_ENV=
SENTRY_DSN=
ANALYTICS_ID=
