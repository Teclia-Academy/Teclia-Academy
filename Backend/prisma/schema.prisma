generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  name              String
  role              String?   @default("student")
  status            String?   @default("active")
  avatarUrl         String?   @map("avatar_url")
  resetPin          String?   @map("reset_pin")
  resetPinExpiresAt DateTime? @map("reset_pin_expires_at")
  planTier          String?   @map("plan_tier")
  riskWhitelisted   Boolean   @default(false) @map("risk_whitelisted")
  entitlementEpoch  Int       @default(0) @map("entitlement_epoch")
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  createdAt         DateTime? @default(now()) @map("created_at")
  content           Content[]
  payments          Payment[]
  subscriptions     Subscription[]
  riskDecisions     RiskDecision[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        Int       @map("user_id")
  familyId      String    @map("family_id")
  tokenHash     String    @unique @map("token_hash")
  deviceLabel   String?   @map("device_label")
  userAgentHash String?   @map("user_agent_hash")
  ipHash        String?   @map("ip_hash")
  expiresAt     DateTime  @map("expires_at")
  rotatedAt     DateTime? @map("rotated_at")
  revokedAt     DateTime? @map("revoked_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model Content {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  type        String
  url         String
  isFree      Int       @default(0) @map("is_free")
  planTier    String?   @default("free") @map("plan_tier")
  uploadedBy  Int       @map("uploaded_by")
  createdAt   DateTime? @default(now()) @map("created_at")
  uploader    User      @relation(fields: [uploadedBy], references: [id])

  @@map("content")
}

model Payment {
  id                      Int       @id @default(autoincrement())
  userId                  Int       @map("user_id")
  planTier                String    @map("plan_tier")
  amount                  Int
  currency                String    @default("usd")
  status                  String    @default("created")
  code                    String?
  provider                String    @default("stripe")
  externalId              String?   @map("external_id")
  paymentMethodId         String?   @map("payment_method_id")
  stripePaymentIntentId   String?   @unique @map("stripe_payment_intent_id")
  stripePaymentMethodId   String?   @map("stripe_payment_method_id")
  stripeCheckoutSessionId String?   @unique @map("stripe_checkout_session_id")
  idempotencyKey          String    @unique @map("idempotency_key")
  clientMessage           String?   @map("client_message")
  ipHash                  String?   @map("ip_hash")
  metadata                String?
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  user   User           @relation(fields: [userId], references: [id])
  events PaymentEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@map("payments")
}

model SiteStat {
  key   String @id
  value Int    @default(0)

  @@map("site_stats")
}

model AdminAuditEvent {
  id          String   @id @default(cuid())
  actorUserId Int      @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  requestId   String?  @map("request_id")
  ipHash      String?  @map("ip_hash")
  beforeJson  String?  @map("before_json")
  afterJson   String?  @map("after_json")
  prevHash    String   @map("prev_hash")
  entryHash   String   @unique @map("entry_hash")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_events")
}

model Subscription {
  id                 Int      @id @default(autoincrement())
  userId             Int      @map("user_id")
  planTier           String   @map("plan_tier")
  status             String   @default("active")
  provider           String   @default("stripe")
  externalId         String   @map("external_id")
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, externalId])
  @@index([userId])
  @@map("subscriptions")
}

model PaymentEvent {
  id             Int       @id @default(autoincrement())
  paymentId      Int?      @map("payment_id")
  type           String
  payload        String
  processedAt    DateTime? @map("processed_at")
  idempotencyKey String    @unique @map("idempotency_key")
  stripeEventId  String?   @unique @map("stripe_event_id")
  outcome        String?
  createdAt      DateTime  @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("payment_events")
}

model RiskDecision {
  id          Int       @id @default(autoincrement())
  userId      Int?      @map("user_id")
  ipHash      String    @map("ip_hash")
  path        String
  signalsJson String    @map("signals_json")
  score       Int
  decision    String
  mode        String
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([ipHash, createdAt])
  @@index([decision, createdAt])
  @@map("risk_decisions")
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  actor       String
  action      String
  entityType  String   @map("entity_type")
  entityId    Int?     @map("entity_id")
  beforeState String?  @map("before_state")
  afterState  String?  @map("after_state")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}
