# ============================================================================
# TECLIA ACADEMIA - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env (frontend) or Backend/.env (backend) as appropriate.
# Never commit real secrets to source control.

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

PORT=3001
NODE_ENV=development

# Prisma database connection. Upstream uses PostgreSQL/Supabase.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Use a dedicated test database; never run tests against production.
TEST_DATABASE_URL=

# Legacy/local database options retained for compatibility with existing tooling.
DATABASE_PATH=
DATABASE_DIR=
SQLITE_DB_PATH=./data/teclia.db
DB_TYPE=postgres

JWT_SECRET=replace_with_a_secure_random_value

# ============================================================================
# SUPABASE AND STORAGE
# ============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=uploads

LOCAL_UPLOADS=true
# Set to false on Vercel/serverless (use Supabase storage instead).
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Legacy upload settings retained for compatibility.
MAX_UPLOAD_SIZE=50
ALLOWED_AVATAR_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=./uploads

# ============================================================================
# EMAIL
# ============================================================================

SENDGRID_API_KEY=
EMAIL_FROM=noreply@teclia-academy.com
PASSWORD_RESET_TEMPLATE_ID=d-your_template_id

# ============================================================================
# OPTIONAL SEED OVERRIDES
# ============================================================================

# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Legacy backend URL and Vite API base URL.
FRONTEND_API_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_NAME=Teclia Academy

# Stripe Elements. Use only a publishable key; never expose a secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# Payments remain disabled unless explicitly enabled.
VITE_PAYMENTS_ENABLED=false

# API base URL for the frontend.
# Local dev: http://localhost:3001/api
# Vercel (same deployment): /api
VITE_API_BASE_URL=http://localhost:3001/api

# ============================================================================
# SECURITY AND CORS
# ============================================================================

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Stripe (backend only — never expose in VITE_ variables)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SESSION_TIMEOUT=3600000

# ============================================================================
# DEVELOPMENT AND DEBUGGING
# ============================================================================

DEBUG=teclia:*
VERBOSE_ERRORS=true

# ============================================================================
# DEPLOYMENT AND OPTIONAL SERVICES
# ============================================================================

GITHUB_TOKEN=your_github_token
DEPLOYMENT_ENV=development
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ANALYTICS_ID=your_analytics_id
