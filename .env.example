# ============================================================================
# TECLIA ACADEMIA - ENVIRONMENT VARIABLES TEMPLATE
# ============================================================================
# Copy this file to .env (frontend) or Backend/.env (backend) as appropriate.
# Never commit real secrets to source control.

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

PORT=3001
NODE_ENV=development

# Prisma database connection. Upstream uses PostgreSQL/Supabase.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Use a dedicated test database; never run tests against production.
TEST_DATABASE_URL=

# Legacy/local database options retained for compatibility with existing tooling.
DATABASE_PATH=
DATABASE_DIR=
SQLITE_DB_PATH=./data/teclia.db
DB_TYPE=postgres

JWT_SECRET=replace_with_a_secure_random_value

# ============================================================================
# SUPABASE AND STORAGE
# ============================================================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BUCKET=uploads

LOCAL_UPLOADS=true
# Set to false on Vercel/serverless (use Supabase storage instead).
UPLOAD_MAX_SIZE_MB=10
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,application/pdf

# Required when LOCAL_UPLOADS=true. Use a long, random value and keep it server-side.
MEDIA_SIGNING_SECRET=replace_with_a_separate_secure_random_value

# Paid-content URL lifetime. Values are constrained to 300-900 seconds.
CONTENT_SIGNED_URL_TTL_SECONDS=900

# Legacy upload settings retained for compatibility.
MAX_UPLOAD_SIZE=50
ALLOWED_AVATAR_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DIR=./uploads

# ============================================================================
# EMAIL
# ============================================================================

SENDGRID_API_KEY=
EMAIL_FROM=noreply@teclia-academy.com
PASSWORD_RESET_TEMPLATE_ID=d-your_template_id

# ============================================================================
# OPTIONAL SEED OVERRIDES
# ============================================================================

# SEED_ADMIN_EMAIL=
# SEED_ADMIN_NAME=
# SEED_ADMIN_PASSWORD=

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Legacy backend URL and Vite API base URL.
FRONTEND_API_URL=http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_NAME=Teclia Academy

# Stripe Elements. Use only a publishable key; never expose a secret key here.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# Payments remain disabled unless explicitly enabled.
VITE_PAYMENTS_ENABLED=false

# API base URL for the frontend.
# Local dev: http://localhost:3001/api
# Vercel (same deployment): /api
VITE_API_BASE_URL=http://localhost:3001/api

# ============================================================================
# SECURITY AND CORS
# ============================================================================

CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Stripe (backend only — never expose in VITE_ variables)
STRIPE_SECRET_KEY=

# Configure exactly one Stripe webhook destination at POST /api/webhooks/stripe.
# POST /api/payments/webhook is a compatibility alias that uses the same verifier
# and dispatcher; do not register it as a second Stripe destination. Copy the
# canonical destination's endpoint signing secret (whsec_...) here.
STRIPE_WEBHOOK_SECRET=

# Maximum accepted Stripe signature age in seconds. Defaults to 300 when unset.
STRIPE_WEBHOOK_TOLERANCE_SEC=300

# Stripe Checkout Session price IDs (Dashboard → Products → Prices)
STRIPE_PRICE_BASICO=price_replace_with_basico_price_id
STRIPE_PRICE_PRO=price_replace_with_pro_price_id
STRIPE_PRICE_MASTER=price_replace_with_master_price_id

# Hosted Checkout redirect URLs ({CHECKOUT_SESSION_ID} is substituted by Stripe)
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/dashboard?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/?checkout=cancelled

# Required only to run `npm run payments:reconcile -- --apply` in production
# (NODE_ENV=production). Set it inline on the command for that one invocation
# rather than leaving it in .env. See "Payment Reconciliation Runbook" in
# DEVELOPER_SETUP.md.
RECONCILE_CONFIRM=

SESSION_TIMEOUT=3600000

# ============================================================================
# RISK ENGINE (Tier A - Fraud Controls)
# ============================================================================
# shadow = log only (default, safe for prod rollout), enforce = block/challenge
RISK_ENGINE_MODE=shadow
# Salt for IP hashing (use a long random secret in production)
RISK_IP_HASH_SALT=replace_with_long_random_secret
# Optional threshold overrides (defaults: 8, 4, 12, 30)
# RISK_THRESHOLD_ATTEMPTS_USER_HOUR=8
# RISK_THRESHOLD_DISTINCT_PM_DAY=4
# RISK_THRESHOLD_FAILS_IP_HOUR=12
# RISK_ACCOUNT_AGE_MINUTES=30

# ============================================================================
# DEVELOPMENT AND DEBUGGING
# ============================================================================

DEBUG=teclia:*
VERBOSE_ERRORS=true

# ============================================================================
# DEPLOYMENT AND OPTIONAL SERVICES
# ============================================================================

# Required for byte-exact Stripe webhook bodies on Vercel. Configure this value
# for Production, Preview, and Development in the Vercel project settings.
# A Vercel production deployment fails during app startup unless it is exactly 0.
NODEJS_HELPERS=0

GITHUB_TOKEN=your_github_token
DEPLOYMENT_ENV=development
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
ANALYTICS_ID=your_analytics_id
